# Auralis AI — environment variables (copy to .env on your OS)
# PowerShell example:
#   $env:PORT="5000"
#   $env:JWT_SECRET="change-me..."
#   $env:GOOGLE_CLIENT_ID=""
#   $env:FIREBASE_PROJECT_ID="auralis-ai-93b95"
#   $env:FIREBASE_CLIENT_EMAIL="<your-service-account-email>"
#   $env:FIREBASE_PRIVATE_KEY="<your-private-key-with-\n>"
#   $env:FIREBASE_WEB_API_KEY="AIzaSyAiTSBpOCsToeQ342LekWI9SCqcV9cexQg"
#   $env:FIREBASE_AUTH_DOMAIN="auralis-ai-93b95.firebaseapp.com"

# --- Core ---
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string-in-production

# --- Legacy Google (ID token) ---
GOOGLE_CLIENT_ID=

# --- Firebase (Google sign-in backend) — project: auralis-ai-93b95 ---
FIREBASE_PROJECT_ID=auralis-ai-93b95
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=AIzaSyAiTSBpOCsToeQ342LekWI9SCqcV9cexQg
FIREBASE_AUTH_DOMAIN=auralis-ai-93b95.firebaseapp.com

# --- Neural MusicGen ---
USE_NEURAL_AI=true
NEURAL_BACKEND=auto
MUSICGEN_MODEL=facebook/musicgen-small
PYTHON=python

# --- HuggingFace (cloud GPU) ---
HF_SPACES_URL=
HF_TOKEN=
